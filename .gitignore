# ---------------------------------------------------------------------------
# Nintendo-copyrighted input and everything derived from it: never commit.
# The repository holds only the recompiler, the runtime and config; each user
# generates the rest locally from their own disc.
# ---------------------------------------------------------------------------

# disc images and extracted files
*.iso
*.wbfs
*.rvz
*.gcm
*.ciso
*.nkit.*
game/

# generated by the recompiler (C translated from the game's code, REL image)
build/
rel_image.bin

# PC runtime data: disc link, NAND with saves, logs, frame dumps
pcdata/
*.sav

# 3DS build outputs (contain the recompiled game; the _full variants also
# contain the disc image)
*.3dsx
*.smdh
*.elf
*.map
*.cxi
*.cia

# PC build outputs
*.exe
*.obj
*.pdb
*.ilk
*.lib
*.exp

# downloaded tools (makerom: get it from github.com/3DSGuy/Project_CTR)
tools/bin/

# Python
__pycache__/
*.pyc

# editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
